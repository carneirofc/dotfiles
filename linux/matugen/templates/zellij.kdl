// Zellij theme generated by matugen from the current wallpaper.
// Source: linux/matugen/templates/zellij.kdl — do not edit the generated file.
// Same structure as themes/carneirofc-mocha.kdl, with Material You roles in place
// of the Catppuccin palette.

themes {
    matugen {
        // Plain UI text (status bar, prompts)
        text_unselected {
            base {{colors.on_surface.default.red}} {{colors.on_surface.default.green}} {{colors.on_surface.default.blue}}
            background {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_0 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            emphasis_1 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            emphasis_2 {{colors.green.default.red}} {{colors.green.default.green}} {{colors.green.default.blue}}
            emphasis_3 {{colors.magenta.default.red}} {{colors.magenta.default.green}} {{colors.magenta.default.blue}}
        }
        // UI text on a selected line
        text_selected {
            base {{colors.on_surface.default.red}} {{colors.on_surface.default.green}} {{colors.on_surface.default.blue}}
            background {{colors.surface_container_high.default.red}} {{colors.surface_container_high.default.green}} {{colors.surface_container_high.default.blue}}
            emphasis_0 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            emphasis_1 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            emphasis_2 {{colors.green.default.red}} {{colors.green.default.green}} {{colors.green.default.blue}}
            emphasis_3 {{colors.magenta.default.red}} {{colors.magenta.default.green}} {{colors.magenta.default.blue}}
        }
        // Tabs / mode indicators — inactive.
        // Dark ribbon so the emphasis colors (hotkey letters) stay readable:
        // pastel accents on a light ribbon background drop below 1.5:1 contrast.
        ribbon_unselected {
            base {{colors.on_surface.default.red}} {{colors.on_surface.default.green}} {{colors.on_surface.default.blue}}
            background {{colors.surface_container_highest.default.red}} {{colors.surface_container_highest.default.green}} {{colors.surface_container_highest.default.blue}}
            emphasis_0 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            emphasis_1 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            emphasis_2 {{colors.blue.default.red}} {{colors.blue.default.green}} {{colors.blue.default.blue}}
            emphasis_3 {{colors.magenta.default.red}} {{colors.magenta.default.green}} {{colors.magenta.default.blue}}
        }
        // Tabs / mode indicators — active.
        // Light (primary) ribbon, so base and emphasis must all be dark.
        ribbon_selected {
            base {{colors.on_primary.default.red}} {{colors.on_primary.default.green}} {{colors.on_primary.default.blue}}
            background {{colors.primary.default.red}} {{colors.primary.default.green}} {{colors.primary.default.blue}}
            emphasis_0 {{colors.on_primary.default.red}} {{colors.on_primary.default.green}} {{colors.on_primary.default.blue}}
            emphasis_1 {{colors.primary_container.default.red}} {{colors.primary_container.default.green}} {{colors.primary_container.default.blue}}
            emphasis_2 {{colors.on_primary_fixed_variant.default.red}} {{colors.on_primary_fixed_variant.default.green}} {{colors.on_primary_fixed_variant.default.blue}}
            emphasis_3 {{colors.on_primary.default.red}} {{colors.on_primary.default.green}} {{colors.on_primary.default.blue}}
        }
        // Tables (e.g. session manager)
        table_title {
            base {{colors.primary.default.red}} {{colors.primary.default.green}} {{colors.primary.default.blue}}
            background {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_0 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            emphasis_1 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            emphasis_2 {{colors.primary.default.red}} {{colors.primary.default.green}} {{colors.primary.default.blue}}
            emphasis_3 {{colors.magenta.default.red}} {{colors.magenta.default.green}} {{colors.magenta.default.blue}}
        }
        table_cell_unselected {
            base {{colors.on_surface.default.red}} {{colors.on_surface.default.green}} {{colors.on_surface.default.blue}}
            background {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_0 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            emphasis_1 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            emphasis_2 {{colors.green.default.red}} {{colors.green.default.green}} {{colors.green.default.blue}}
            emphasis_3 {{colors.magenta.default.red}} {{colors.magenta.default.green}} {{colors.magenta.default.blue}}
        }
        table_cell_selected {
            base {{colors.on_surface.default.red}} {{colors.on_surface.default.green}} {{colors.on_surface.default.blue}}
            background {{colors.surface_container_high.default.red}} {{colors.surface_container_high.default.green}} {{colors.surface_container_high.default.blue}}
            emphasis_0 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            emphasis_1 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            emphasis_2 {{colors.green.default.red}} {{colors.green.default.green}} {{colors.green.default.blue}}
            emphasis_3 {{colors.magenta.default.red}} {{colors.magenta.default.green}} {{colors.magenta.default.blue}}
        }
        // Lists (e.g. plugin manager)
        list_unselected {
            base {{colors.on_surface.default.red}} {{colors.on_surface.default.green}} {{colors.on_surface.default.blue}}
            background {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_0 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            emphasis_1 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            emphasis_2 {{colors.green.default.red}} {{colors.green.default.green}} {{colors.green.default.blue}}
            emphasis_3 {{colors.magenta.default.red}} {{colors.magenta.default.green}} {{colors.magenta.default.blue}}
        }
        list_selected {
            base {{colors.on_surface.default.red}} {{colors.on_surface.default.green}} {{colors.on_surface.default.blue}}
            background {{colors.surface_container_high.default.red}} {{colors.surface_container_high.default.green}} {{colors.surface_container_high.default.blue}}
            emphasis_0 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            emphasis_1 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            emphasis_2 {{colors.green.default.red}} {{colors.green.default.green}} {{colors.green.default.blue}}
            emphasis_3 {{colors.magenta.default.red}} {{colors.magenta.default.green}} {{colors.magenta.default.blue}}
        }
        // Pane frames
        frame_unselected {
            base {{colors.outline.default.red}} {{colors.outline.default.green}} {{colors.outline.default.blue}}
            background {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_0 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            emphasis_1 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            emphasis_2 {{colors.green.default.red}} {{colors.green.default.green}} {{colors.green.default.blue}}
            emphasis_3 {{colors.magenta.default.red}} {{colors.magenta.default.green}} {{colors.magenta.default.blue}}
        }
        frame_selected {
            base {{colors.primary.default.red}} {{colors.primary.default.green}} {{colors.primary.default.blue}}
            background {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_0 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            emphasis_1 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            emphasis_2 {{colors.magenta.default.red}} {{colors.magenta.default.green}} {{colors.magenta.default.blue}}
            emphasis_3 {{colors.primary.default.red}} {{colors.primary.default.green}} {{colors.primary.default.blue}}
        }
        // Frame highlight (e.g. pane group marking, special modes)
        frame_highlight {
            base {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            background {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_0 {{colors.magenta.default.red}} {{colors.magenta.default.green}} {{colors.magenta.default.blue}}
            emphasis_1 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            emphasis_2 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            emphasis_3 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
        }
        // Command pane exit status indicators
        exit_code_success {
            base {{colors.green.default.red}} {{colors.green.default.green}} {{colors.green.default.blue}}
            background {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_0 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            emphasis_1 {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_2 {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_3 {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
        }
        exit_code_error {
            base {{colors.red.default.red}} {{colors.red.default.green}} {{colors.red.default.blue}}
            background {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_0 {{colors.yellow.default.red}} {{colors.yellow.default.green}} {{colors.yellow.default.blue}}
            emphasis_1 {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_2 {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
            emphasis_3 {{colors.surface.default.red}} {{colors.surface.default.green}} {{colors.surface.default.blue}}
        }
        // Cursor colors for users attached to a shared session, in join order
        multiplayer_user_colors {
            player_1 {{colors.magenta.default.red}} {{colors.magenta.default.green}} {{colors.magenta.default.blue}}
            player_2 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            player_3 {{colors.green.default.red}} {{colors.green.default.green}} {{colors.green.default.blue}}
            player_4 {{colors.yellow.default.red}} {{colors.yellow.default.green}} {{colors.yellow.default.blue}}
            player_5 {{colors.blue.default.red}} {{colors.blue.default.green}} {{colors.blue.default.blue}}
            player_6 {{colors.primary.default.red}} {{colors.primary.default.green}} {{colors.primary.default.blue}}
            player_7 {{colors.red.default.red}} {{colors.red.default.green}} {{colors.red.default.blue}}
            player_8 {{colors.tertiary.default.red}} {{colors.tertiary.default.green}} {{colors.tertiary.default.blue}}
            player_9 {{colors.cyan.default.red}} {{colors.cyan.default.green}} {{colors.cyan.default.blue}}
            player_10 {{colors.primary.default.red}} {{colors.primary.default.green}} {{colors.primary.default.blue}}
        }
    }
}
